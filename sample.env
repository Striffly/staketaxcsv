######### Environment variables ###################################################
#
# - Most reports have a working default node option.
# - Below are the reports/nodes where no default is available (for various reasons),
#   such that it must be supplied for the report to work.
# - See src/settings_csv.py for complete list of environment variables that can be used.
#

# Required for ARCH/ATOM/EVMOS/JUNO/OSMO/STRD/TIA (See https://api.mintscan.io for details on key)
# Délai (en secondes) entre chaque requête RPC Solana. -1 = valeur par défaut (0.3s nœud public, 0.1s nœud perso)
# Augmenter si rate-limited (ex: 1.0)
STAKETAX_SOL_RPC_SLEEP=-1

STAKETAX_MINTSCAN_KEY=""

STAKETAX_BLD_NODE_RPC=""
STAKETAX_HUAHUA_NODE=""
STAKETAX_KUJI_NODE=""
STAKETAX_REGEN_NODE=""
STAKETAX_ROWAN_NODE=""
STAKETAX_SCRT_NODE=""
STAKETAX_STARS_NODE=""
STAKETAX_TORI_NODE=""

STAKETAX_SOL_OVERRIDES_FILE=